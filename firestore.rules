rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure the "users" collection against privilege escalation
    match /users/{userId} {
      allow read: if true; 
      
      // Enforce safe roles on document creation
      allow create: if request.resource.data.role in ['student', 'teacher', 'parent']
                    && request.resource.data.roles.hasOnly(['student', 'teacher', 'parent']);
                    
      // Prevent privilege escalation on document updates
      allow update: if (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles'])) 
                    || (request.resource.data.roles.hasOnly(['student', 'teacher', 'parent']));
                    
      allow delete: if true; // Kept open like the rest of the DB
    }
    // Secure the "tutors" collection against Quota Hackers
    match /tutors/{tutorId} {
      allow read, create, delete: if true;
      
      // Enforce the Weekly Token limits
      allow update: if 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['weeklyQuota']))
        || 
        (
          request.resource.data.weeklyQuota.tokensUsed <= (
            (request.resource.data.get('subscriptionPlan', 'basic') == 'pro' || request.resource.data.get('isSubscribed', false) == true) ? 15 : 5
          )
        );
    }

    // Secure the "parents" collection to enforce daily usage quotas securely
    match /parents/{parentId} {
      allow read, create, delete: if true;
      
      allow update: if 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dailyUsage']))
        || 
        (
          request.resource.data.dailyUsage.count <= 5 &&
          (
            // If it's the same date, must increment by exactly 1
            (request.resource.data.dailyUsage.date == resource.data.dailyUsage.date && 
             request.resource.data.dailyUsage.count == resource.data.dailyUsage.count + 1)
            ||
            // If it's a new date, must reset to exactly 1
            (request.resource.data.dailyUsage.date != resource.data.dailyUsage.date && 
             request.resource.data.dailyUsage.count == 1)
          )
        );
    }

    // Secure the "applications" collection to enforce the quota chain
    match /applications/{appId} {
      allow read, update, delete: if true; // Existing behavior preserved
      
      // ⚠️ FUTURE RAZORPAY LOCKDOWN: When you are ready to switch to Razorpay, 
      // replace the `allow update: if true;` above with the following to block frontend hackers:
      // allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['feePaid', 'demoPaymentPaid'])
      //               && (request.resource.data.status == resource.data.status 
      //                   || !(request.resource.data.status in ['tuition_started', 'demo_booking_phase']));

      // Creating an application requires updating the initiator's quota tracker in the exact same batch/transaction
      allow create: if true 
        && (
            (request.resource.data.initiator == 'student' 
             && request.resource.data.parentDocId != null
             && getAfter(/databases/$(database)/documents/parents/$(request.resource.data.parentDocId)).data.dailyUsage.lastUpdated == request.time)
            ||
            (request.resource.data.initiator == 'teacher'
             && request.resource.data.tutorDocId != null
             && getAfter(/databases/$(database)/documents/tutors/$(request.resource.data.tutorDocId)).data.weeklyQuota.lastUpdated == request.time)
        );
    }

    // -------------------------------------------------------------------------
    // FUTURE RAZORPAY INTEGRATION: Secure the new "payments" ledger
    // -------------------------------------------------------------------------
    match /payments/{paymentId} {
      // Anyone involved in the application can read the receipt
      allow read: if true; 
      
      // ABSOLUTELY NO FRONTEND WRITES. Only the secure Backend API (which bypasses rules) 
      // is allowed to create or modify financial ledgers after verifying Razorpay signatures.
      allow write: if false; 
    }

    // Keep the rest of the database completely open (as it was before)
    // This ensures we do not break any existing design or logic in your app.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'users' && collection != 'tutors' && collection != 'parents' && collection != 'applications' && collection != 'payments';
    }
  }
}
