rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure the "users" collection against privilege escalation and mass deletion
    match /users/{userId} {
      allow read: if true; 
      
      // Enforce safe roles on document creation
      allow create: if request.resource.data.role in ['student', 'teacher', 'parent']
                    && request.resource.data.roles.hasOnly(['student', 'teacher', 'parent']);
                    
      // Prevent privilege escalation on document updates
      allow update: if (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles'])) 
                    || (request.resource.data.roles.hasOnly(['student', 'teacher', 'parent']));
                    
      // Lock down deletion to the actual user
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Secure the "tutors" collection against Quota Hackers and mass deletion
    match /tutors/{tutorId} {
      allow read, create: if true;
      allow delete: if request.auth != null && request.auth.uid == tutorId;
      
      // Enforce the Weekly Token limits
      allow update: if 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['weeklyQuota']))
        || 
        (
          request.resource.data.weeklyQuota.tokensUsed <= (
            (request.resource.data.get('subscriptionPlan', 'basic') == 'pro' || request.resource.data.get('isSubscribed', false) == true) ? 15 : 5
          )
        );
    }

    // Secure the "parents" collection to enforce daily usage quotas securely and prevent mass deletion
    match /parents/{parentId} {
      allow read, create: if true;
      allow delete: if request.auth != null && request.auth.uid == parentId;
      
      allow update: if 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dailyUsage']))
        || 
        (
          request.resource.data.dailyUsage.count <= 5 &&
          (
            // If it's the same date, must increment by exactly 1
            (request.resource.data.dailyUsage.date == resource.data.dailyUsage.date && 
             request.resource.data.dailyUsage.count == resource.data.dailyUsage.count + 1)
            ||
            // If it's a new date, must reset to exactly 1
            (request.resource.data.dailyUsage.date != resource.data.dailyUsage.date && 
             request.resource.data.dailyUsage.count == 1)
          )
        );
    }

    // Secure the "applications" collection against price manipulation and fake payments
    match /applications/{appId} {
      allow read, delete: if true; 
      
      // 1. Prevent ANY frontend modification of feePaid or demoPaymentPaid (Backend only)
      // 2. Lock down finalPrice, budget, and currentOffer if the app has moved past the negotiation phase
      allow update: if 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['feePaid', 'demoPaymentPaid']))
        &&
        (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['finalPrice', 'budget', 'currentOffer']))
          || 
          !(resource.data.status in ['accepted', 'tuition_started', 'demo_booking_phase', 'demo_scheduled', 'waiting_for_parent_decision', 'demo_pending_payment'])
        );

      // Creating an application requires updating the initiator's quota tracker in the exact same batch/transaction
      allow create: if true 
        && (
            (request.resource.data.initiator == 'student' 
             && request.resource.data.parentDocId != null
             && getAfter(/databases/$(database)/documents/parents/$(request.resource.data.parentDocId)).data.dailyUsage.lastUpdated == request.time)
            ||
            (request.resource.data.initiator == 'teacher'
             && request.resource.data.tutorDocId != null
             && getAfter(/databases/$(database)/documents/tutors/$(request.resource.data.tutorDocId)).data.weeklyQuota.lastUpdated == request.time)
        );
    }

    // -------------------------------------------------------------------------
    // PAYMENTS LEDGER: Strictly backend only writes
    // -------------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if true; 
      allow write: if false; 
    }

    // -------------------------------------------------------------------------
    // REVIEW SYSTEM: Secure the reviews collection
    // -------------------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if true; 
      allow write: if false; 
    }

    // Prevent anonymous mass-deletion on the rest of the DB while keeping it open for logic
    match /{collection}/{document=**} {
      allow read, create, update: if collection != 'users' && collection != 'tutors' && collection != 'parents' && collection != 'applications' && collection != 'payments' && collection != 'reviews';
      allow delete: if request.auth != null && collection != 'users' && collection != 'tutors' && collection != 'parents' && collection != 'applications' && collection != 'payments' && collection != 'reviews';
    }
  }
}
